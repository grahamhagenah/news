mponents.quote/e278d354-cab2-46b3-85bb-252e693da7bb_750/website.components.quote.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.quote\" data-sqsp-block=\"quote\" data-website-component-id=\"50374594fef77c86c6f5\" id=\"block-50374594fef77c86c6f5\"><div class=\"sqs-block-content\">\n  \n\n<figure class=\"sqs-quote-block-contents block-animation-none\">\n  <blockquote data-animation-role=\"quote\"\n  >\n    <span>“</span>It was such a delight to attend your class.  My nervous system has been a wreck and it was wonderful to be in a place that felt safe for my body.  I haven’t moved my “yogi” body in years and it felt so good to wake up the cobwebs.<br/><br/>Thank you for providing such a beautiful space for me in a day that I really needed it.<span>”</span>\n  </blockquote>\n  <figcaption class=\"source\">&mdash; Maria</figcaption>\n  \n\n\n\n</figure>\n\n\n\n  \n<style id=\"container-styles\">#block-50374594fef77c86c6f5 {\n    \n    \n    \n\n\n\n  }\n\n  #block-50374594fef77c86c6f5  {\n    \n    padding: var(--tweak-quote-block-padding);\n  \n}\n\n  #block-50374594fef77c86c6f5 {\n      mix-blend-mode: var(--tweak-quote-block-blend);\n      border-radius: var(--tweak-quote-block-radius);\n  }\n\n  \n  \n\n\n\n  \n  \n\n  #block-50374594fef77c86c6f5 {\n    }\n\n</style>\n\n<style id=\"override-container-styles\">\n    @media screen and (max-width: 767px) {\n          \n            \n\n#block-50374594fef77c86c6f5 {\n            \n            }\n        }\n    \n  \n    @media screen and (max-width: 767px) {\n          #block-50374594fef77c86c6f5  {\n            \n            }\n        }\n    \n  @media screen and (max-width: 767px) {\n          \n          \n\n          \n          \n          \n        }</style>\n\n  <style class=\"transform-overrides-vars\">\n  \n</style>\n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-a4cc521993c023a5e5bf\"><div class