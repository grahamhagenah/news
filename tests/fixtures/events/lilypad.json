quarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/b1d3b643-7b74-42b1-a727-3e6c1e3efe18/image1+%282%29.jpeg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/b1d3b643-7b74-42b1-a727-3e6c1e3efe18/image1+%282%29.jpeg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/b1d3b643-7b74-42b1-a727-3e6c1e3efe18/image1+%282%29.jpeg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n              <div class=\"image-overlay\" style=\"overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\"></div>\n            </div>\n          \n            </div>\n          \n\n        </div>\n\n        \n          \n          <figcaption class=\"image-card-wrapper\" data-width-ratio>\n            <div class=\"image-card sqs-dynamic-text-container\" data-sqsp-image-classic-block-content-container>\n\n              \n\n              \n                <div class=\"image-subtitle-wrapper\" data-sqsp-image-classic-block-subtitle><div class=\"image-subtitle sqs-dynamic-text\"\n                \n  \n><p class=\"\" style=\"white-space:pre-wrap;\">Prepare to relax and rejuvenate your body, mind, and spirit in this peaceful yoga class. Explore the guided practice of Hatha Yoga and experience a series of classical Yoga asanas (physical postures), pranayama (breath control), Yoga Nidra (deep relaxation) and meditation. </p></div></div>\n              \n\n              \n\n            </div>\n          </figcaption>\n        \n\n      </figure>\n\n    \n\n  \n\n\n</div></div><div class=\"sqs-block image-block sqs-block-image\" data-block-type=\"5\" data-sqsp-block=\"image-classic\" id=\"block-904c69e842d2b7f47bf3\"><div class=\"sqs-block-content\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n\n    \n\n      <figure\n          class=\"\n            sqs-block-image-figure\n            image-block-outer-wrapper\n            image-block-v2\n            design-layout-card\n            combination-animation-none\n            individual-animation-none\n            individual-text-animation-none\n            image-position-left\n            \n          \"\n          data-scrolled\n          data-test=\"image-block-v2-outer-wrapper\"\n          data-sqsp-image-classic-block-layout=\"card\"\n      >\n\n        <div class=\"intrinsic\">\n          \n            <div\n          \n              class=\"\n                \n                image-inset\"\n              data-animation-role=\"image\"\n              data-description=\"\"\n              \n  \n\n          >\n            <div data-sqsp-image-classic-block-image-container class=\"sqs-image-shape-container-element\n              \n                content-fit\n              \n            \" style=\"\n              position: relative;\n              overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\n              \n            \">\n              \n              \n              \n              \n              \n              \n              \n              <img data-stretch=\"false\" data-src=\"https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg\" data-image=\"https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg\" data-image-dimensions=\"1000x667\" data-image-focal-point=\"0.5,0.5\" alt=\"\" data-load=\"false\" elementtiming=\"system-image-block\" data-sqsp-image-classic-block-image src=\"https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg\" width=\"1000\" height=\"667\" alt=\"\" sizes=\"(max-width: 640px) 100vw, (max-width: 767px) 100vw, 100vw\" style=\"display:block;object-fit: contain;\" onload=\"this.classList.add(&quot;loaded&quot;)\" srcset=\"https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg?format=100w 100w, https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg?format=300w 300w, https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg?format=500w 500w, https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg?format=750w 750w, https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg?format=1000w 1000w, https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg?format=1500w 1500w, https://images.squarespace-cdn.com/content/v1/5813d44e8419c25c3b432ef4/1713280514483-TYJU3LJ4YJHXVQXS9IAP/IMG_3603.jpeg?format=2500w 2500w\" loading=\"lazy\" decoding=\"async\" data-loader=\"sqs\">\n\n              <div class=\"image-overlay\" style=\"overflow: hidden;-webkit-mask-image: -webkit-radial-gradient(white, black);\"></div>\n            </div>\n          \n            </div>\n          \n\n        </div>\n\n        \n          \n          <figcaption class=\"image-card-wrapper\" data-width-ratio>\n            <div class=\"image-card sqs-dynamic-text-container\" data-sqsp-image-classic-block-content-container>\n\n              \n\n              \n                <div class=\"image-subtitle-wrapper\" data-sqsp-image-classic-block-subtitle><div class=\"image-subtitle sqs-dynamic-text\"\n                \n  \n><p class=\"\" style=\"white-space:pre-wrap;\">Parashakti  (Vienna) is an Integral Yoga instructor and a new-ish resident to Cambridge from two and a half years studying and teaching at <a href=\"https://www.yogaville.org/\">Satchidananda Ashram</a> in Yogaville, Virginia.  She is currently teaching weekly Hatha Yoga classes at the Lilypad and other places around Cambridge.</p></div></div>\n              \n\n              \n\n            </div>\n          </figcaption>\n        \n\n      </figure>\n\n    \n\n  \n\n\n</div></div><div class=\"sqs-block html-block sqs-block-html\" data-block-type=\"2\" data-sqsp-block=\"text\" id=\"block-b17e423257130428ac97\"><div class=\"sqs-block-content\">\n\n<div class=\"sqs-html-content\" data-sqsp-text-block-content>\n  <p class=\"\" style=\"white-space:pre-wrap;\">Musical accompaniment on the Grand Piano provided by Jesse Gallagher, along with selections from his meditation album \"The Inner Sound.\"</p>\n</div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  \n  \n\n\n\n</div></div><div class=\"sqs-block website-component-block sqs-block-website-component sqs-block-embed embed-block\" data-block-css=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.embed/80a2d965-d504-40f3-9418-486cd207872d_649/website.components.embed.styles.css&quot;]\" data-block-scripts=\"[&quot;https://definitions.sqspcdn.com/website-component-definition/static-assets/website.components.embed/80a2d965-d504-40f3-9418-486cd207872d_649/website.components.embed.visitor.js&quot;]\" data-block-type=\"1337\" data-definition-name=\"website.components.embed\" data-sqsp-block=\"embed\" data-website-component-id=\"f280605cda9435490f16\" id=\"block-f280605cda9435490f16\"><div class=\"sqs-block-content\">\n  \n\n<div\n  class=\"sqs-embed-container\"\n  data-localized=\"{&quot;embedInvalid&quot;:&quot;Enter a valid embed URL or code.&quot;,&quot;embedTitle&quot;:&quot;Embed Block&quot;,&quot;embedUninitialized&quot;:&quot;Add an embed URL or code.&quot;,&quot;enableSafeModeButton&quot;:&quot;Preview in safe mode&quot;,&quot;enableSafeModeText&quot;:&quot;This block contains embedded scripts. Embedded scripts are disabled while you're logged in and editing your site.&quot;,&quot;enableSafeModeTitle&quot;:&quot;Embedded Scripts&quot;,&quot;exitSafeModeButton&quot;:&quot;Exit safe preview&quot;,&quot;exitSafeModeText&quot;:&quot;Plea